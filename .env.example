# Copy to .env and fill in. NEVER commit .env.

# --- Model access ---
# The key is read from the environment only. It is never hardcoded, never
# written to the cache or the run log, and .env is git-ignored. Each team
# member uses their OWN provider project and key: the Model Selection Note
# records that rate limits apply per project, so keys sharing a project share
# one quota.
GEMINI_API_KEY=

MODEL_PROVIDER=google-genai

# Pinned by EXACT version. Never an alias ending in -latest: a provider-side
# version change must not silently alter our evaluation results.
# (Model Selection Note, "Pinned model string".)
MODEL_NAME=gemini-3.1-flash-lite

# Decoding settings, fixed by Prompt Specification v1.0 section 4. These are
# part of the specification because they change output and must be held
# constant across evaluation runs. The application reads them from config.py,
# not from here; they are recorded for reference and must agree.
#   temperature       0     extraction is deterministic; variance is a defect
#   max output tokens 2048  sufficient for a multi-item quotation record
#   thinking budget   0     spec says "minimum or disabled"
#   response mime     application/json
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0

# Prompt version. Bumping this invalidates every cached extraction and every
# evaluation result recorded against the old version. See prompts.py.
PROMPT_VERSION=1.0

# Legacy aliases, still read as fallbacks by config.load_api_key().
MODEL_API_KEY=

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Data paths (synthetic datasets only) ---
INVENTORY_DATA_PATH=./knowledge/data/inventory.csv
QUOTATIONS_DATA_PATH=./knowledge/data/quotations.json
SUPPLIERS_DATA_PATH=./knowledge/data/suppliers.json

# --- Procurement rules (deterministic, not model-controlled) ---
CURRENCY=UGX
USD_TO_UGX_RATE=
MIN_QUOTATIONS_REQUIRED=3
APPROVAL_THRESHOLD_UGX=

# --- Agent bounds ---
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=120
