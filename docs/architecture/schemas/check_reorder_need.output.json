{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeorgeLukaanya/bse4104-procurement-agent/blob/main/docs/architecture/schemas/check_reorder_need.output.json",
  "title": "check_reorder_need output",
  "description": "The reorder list for one weekly review. Carries no supplier, price offer or recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "tool_version",
    "status",
    "data",
    "errors",
    "trace"
  ],
  "properties": {
    "tool": {
      "const": "check_reorder_need"
    },
    "tool_version": {
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "no_result",
        "invalid_input",
        "unauthorized",
        "unavailable",
        "failed"
      ],
      "description": "ok — the call succeeded and `data` is populated. no_result — the call was valid and nothing matched, which is an answer, not a failure. invalid_input — the request did not conform to the input schema. unauthorized — the caller's role may not invoke this tool, or the tool was not on the orchestration allow-list. unavailable — a data source could not be read. failed — the tool ran and could not complete."
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_date",
            "evaluated_count",
            "flagged_count",
            "no_reorder_required",
            "items"
          ],
          "properties": {
            "review_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "evaluated_count": {
              "type": "integer",
              "minimum": 0
            },
            "flagged_count": {
              "type": "integer",
              "minimum": 0
            },
            "no_reorder_required": {
              "type": "boolean",
              "description": "True when nothing is at or below its reorder point. Requirement 1.5 ends the review here."
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sku",
                  "item_name",
                  "category",
                  "unit_of_measure",
                  "current_stock",
                  "reorder_point",
                  "target_stock_level",
                  "reorder_quantity",
                  "estimated_total_ugx",
                  "location",
                  "at_or_below_reorder_point"
                ],
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "item_name": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "cement and masonry",
                      "hand tools and safety equipment",
                      "electrical and plumbing"
                    ]
                  },
                  "unit_of_measure": {
                    "type": "string"
                  },
                  "current_stock": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reorder_point": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "target_stock_level": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reorder_quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "target_stock_level minus current_stock, computed here. Requirement 1.4."
                  },
                  "estimated_unit_cost_ugx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Last recorded unit cost. An estimate for band selection only, never a quoted price."
                  },
                  "estimated_total_ugx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "reorder_quantity multiplied by estimated_unit_cost_ugx. Selects the POL-001 value band; it is not a price."
                  },
                  "location": {
                    "type": "string"
                  },
                  "at_or_below_reorder_point": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "description": "Empty when status is ok or no_result. Every applicable error is reported, never only the first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "MISSING_PARAMETER",
              "INVALID_PARAMETER",
              "UNKNOWN_SKU",
              "UNKNOWN_SUPPLIER",
              "UNAUTHORIZED_ROLE",
              "TOOL_NOT_ALLOWED",
              "DATA_SOURCE_UNAVAILABLE",
              "DATA_INTEGRITY_ERROR",
              "INSUFFICIENT_QUOTATIONS",
              "INCOMPARABLE_QUOTATION",
              "EXCHANGE_RATE_REQUIRED",
              "MISSING_COMPONENT",
              "FORBIDDEN_TRANSITION"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request field the error attaches to, or null for a whole-call error."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable statement of what was wrong. Never a repaired value."
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "called_at",
        "caller_role",
        "latency_ms",
        "data_fingerprint"
      ],
      "description": "Appended verbatim to evidence/traces/tool-runs.jsonl. Never carries a secret.",
      "properties": {
        "called_at": {
          "type": "string",
          "format": "date-time"
        },
        "caller_role": {
          "type": "string",
          "enum": [
            "PROCUREMENT_OFFICER",
            "PROCUREMENT_MANAGER",
            "AGENT"
          ],
          "description": "Injected by the orchestration layer. Never supplied by the model."
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "data_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "description": "SHA-256 of the data source as read, matching the checksum in knowledge/source-register.csv. Null for tools that read no file."
        }
      }
    }
  }
}
