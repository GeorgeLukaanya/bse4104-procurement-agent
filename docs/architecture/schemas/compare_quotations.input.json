{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeorgeLukaanya/bse4104-procurement-agent/blob/main/docs/architecture/schemas/compare_quotations.input.json",
  "title": "compare_quotations input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sku",
    "reorder_quantity",
    "comparison_date"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "pattern": "^AH-[A-Z]{2}-[0-9]{3}$"
    },
    "reorder_quantity": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "Quantity to price, normally the figure check_reorder_need computed."
    },
    "comparison_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the comparison is made on. Governs quotation validity under POL-005-C03."
    },
    "quotation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^QT-[0-9]{3}$"
      },
      "description": "Restrict to these offers. Omit to use every offer held for the SKU."
    },
    "exchange_rate_ugx_per_usd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Required when any candidate is not in UGX; otherwise EXCHANGE_RATE_REQUIRED. POL-003-C01."
    },
    "exchange_rate_effective_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
