{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeorgeLukaanya/bse4104-procurement-agent/blob/main/docs/architecture/schemas/compare_quotations.output.json",
  "title": "compare_quotations output",
  "description": "A deterministic landed-cost comparison. Every figure is computed here in code. Requirement 6.6 forbids the model from contributing any arithmetic to this table, and the tool emits no recommendation — ranking is not awarding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "tool_version",
    "status",
    "data",
    "errors",
    "trace"
  ],
  "properties": {
    "tool": {
      "const": "compare_quotations"
    },
    "tool_version": {
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "no_result",
        "invalid_input",
        "unauthorized",
        "unavailable",
        "failed"
      ],
      "description": "ok — the call succeeded and `data` is populated. no_result — the call was valid and nothing matched, which is an answer, not a failure. invalid_input — the request did not conform to the input schema. unauthorized — the caller's role may not invoke this tool, or the tool was not on the orchestration allow-list. unavailable — a data source could not be read. failed — the tool ran and could not complete."
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sku",
            "reorder_quantity",
            "comparison_date",
            "currency",
            "ranked",
            "excluded",
            "quotation_requirement",
            "sole_eligible_option"
          ],
          "properties": {
            "sku": {
              "type": "string"
            },
            "reorder_quantity": {
              "type": "integer"
            },
            "comparison_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "currency": {
              "const": "UGX",
              "description": "Comparison currency. POL-003-C01."
            },
            "exchange_rate": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ugx_per_usd",
                    "effective_date"
                  ],
                  "properties": {
                    "ugx_per_usd": {
                      "type": "number"
                    },
                    "effective_date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              ],
              "description": "Disclosed whenever a converted figure appears. Null when every candidate was already in UGX."
            },
            "ranked": {
              "type": "array",
              "description": "Ascending landed cost. Ties break on supplier name, ascending alphabetical. Requirement 6.2.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rank",
                  "quotation_id",
                  "supplier_id",
                  "supplier_name",
                  "normalised_unit_cost_ugx",
                  "extended_cost_ugx",
                  "vat_amount_ugx",
                  "delivery_cost_ugx",
                  "landed_cost_ugx"
                ],
                "properties": {
                  "rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quotation_id": {
                    "type": "string"
                  },
                  "supplier_id": {
                    "type": "string"
                  },
                  "supplier_name": {
                    "type": "string"
                  },
                  "original_currency": {
                    "type": "string"
                  },
                  "original_unit_price": {
                    "type": "number"
                  },
                  "unit_conversion_factor": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Stocking units per quoted unit. Null when the quoted unit already matches. POL-003-C02."
                  },
                  "normalised_unit_cost_ugx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Price per stocking unit in UGX, net of VAT, after unit and currency normalisation. Always net, so that an inclusive and an exclusive quotation are comparable on the same basis. POL-003-C03."
                  },
                  "extended_cost_ugx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "normalised_unit_cost_ugx multiplied by reorder_quantity."
                  },
                  "vat_amount_ugx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Applicable VAT, shown separately whether the quoted price was inclusive or exclusive. POL-003-C03."
                  },
                  "delivery_cost_ugx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Stated delivery or freight, apportioned to this item."
                  },
                  "landed_cost_ugx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Total cost to Atlantic Hardware. The ranking key."
                  },
                  "lead_time_days": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "validity_date": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tie_broken_on_supplier_name": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "excluded": {
              "type": "array",
              "description": "Offers not ranked, each with every reason. Requirement 6.3 presents these separately rather than dropping them.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "quotation_id",
                  "reasons"
                ],
                "properties": {
                  "quotation_id": {
                    "type": "string"
                  },
                  "supplier_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "supplier_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reasons": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "AVL_ABSENT",
                        "BLACKLISTED",
                        "SUSPENDED",
                        "OUT_OF_CATEGORY",
                        "EXPIRED",
                        "NAME_DISCREPANCY",
                        "INCOMPARABLE_QUOTATION"
                      ]
                    }
                  },
                  "missing_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Named fields whose absence blocks landed cost. Requirement 6.3 states which field is missing."
                  }
                }
              }
            },
            "quotation_requirement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value_band",
                "clause",
                "required_count",
                "eligible_count",
                "satisfied"
              ],
              "description": "POL-001 competition check on the estimated value of this line.",
              "properties": {
                "value_band": {
                  "type": "string",
                  "enum": [
                    "below_500k",
                    "500k_to_under_5m",
                    "5m_and_above"
                  ]
                },
                "clause": {
                  "type": "string",
                  "enum": [
                    "POL-001-C01",
                    "POL-001-C02",
                    "POL-001-C03"
                  ]
                },
                "required_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "eligible_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "satisfied": {
                  "type": "boolean"
                },
                "exception_required": {
                  "type": "boolean",
                  "description": "True when the required count was not met. POL-001-C04 needs a recorded reason and Manager approval."
                }
              }
            },
            "sole_eligible_option": {
              "type": "boolean",
              "description": "True when exactly one eligible offer exists. Requirement 6.4 records that competitive comparison was not possible."
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "description": "Empty when status is ok or no_result. Every applicable error is reported, never only the first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "MISSING_PARAMETER",
              "INVALID_PARAMETER",
              "UNKNOWN_SKU",
              "UNKNOWN_SUPPLIER",
              "UNAUTHORIZED_ROLE",
              "TOOL_NOT_ALLOWED",
              "DATA_SOURCE_UNAVAILABLE",
              "DATA_INTEGRITY_ERROR",
              "INSUFFICIENT_QUOTATIONS",
              "INCOMPARABLE_QUOTATION",
              "EXCHANGE_RATE_REQUIRED",
              "MISSING_COMPONENT",
              "FORBIDDEN_TRANSITION",
              "OUTPUT_SCHEMA_INVALID"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request field the error attaches to, or null for a whole-call error."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable statement of what was wrong. Never a repaired value."
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "called_at",
        "caller_role",
        "latency_ms",
        "data_fingerprint"
      ],
      "description": "Appended verbatim to evidence/traces/tool-runs.jsonl. Never carries a secret.",
      "properties": {
        "called_at": {
          "type": "string",
          "format": "date-time"
        },
        "caller_role": {
          "type": "string",
          "enum": [
            "PROCUREMENT_OFFICER",
            "PROCUREMENT_MANAGER",
            "AGENT"
          ],
          "description": "Injected by the orchestration layer. Never supplied by the model."
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "data_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "description": "SHA-256 of the data source as read, matching the checksum in knowledge/source-register.csv. Null for tools that read no file."
        }
      }
    }
  }
}
