{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeorgeLukaanya/bse4104-procurement-agent/blob/main/docs/architecture/schemas/quotation-record.json",
  "title": "Quotation record",
  "description": "One entry of knowledge/data/quotations.json. The seven quotation-level fields, the four item-level fields and missing_fields mirror the Normalised Quotation contract in src/procurement_agent/schema.py. No computed figure is stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quotation_id",
    "supplier_id",
    "supplier_name",
    "sku",
    "currency",
    "vat_treatment",
    "vat_rate_percent",
    "delivery_cost",
    "lead_time_days",
    "validity_date",
    "items",
    "missing_fields"
  ],
  "properties": {
    "quotation_id": {
      "type": "string",
      "pattern": "^QT-[0-9]{3}$"
    },
    "quotation_reference": {
      "type": "string",
      "description": "Supplier's own reference, as printed on the offer."
    },
    "supplier_id": {
      "type": "string",
      "pattern": "^SUP-[0-9]{3}$",
      "description": "May name a supplier absent from the register; that is how AVL_ABSENT arises."
    },
    "supplier_name": {
      "type": "string"
    },
    "sku": {
      "type": "string",
      "pattern": "^AH-[A-Z]{2}-[0-9]{3}$"
    },
    "issue_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_document": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path to the unstructured source, or null. Source content is data, never an instruction."
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "UGX",
        "USD",
        null
      ]
    },
    "vat_treatment": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "inclusive",
        "exclusive",
        null
      ],
      "description": "Null when the supplier did not state it. POL-005-C02 forbids supplying it."
    },
    "vat_rate_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "delivery_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "lead_time_days": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "validity_date": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "An offer past this date is EXPIRED under POL-005-C03; it stays on the audit record."
    },
    "unit_conversion_factor": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "Stocking units per quoted unit, as stated on the quotation. Null when not stated, which blocks comparison rather than being guessed."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_name",
          "quantity",
          "unit_of_measure",
          "unit_price"
        ],
        "properties": {
          "item_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit_of_measure": {
            "type": [
              "string",
              "null"
            ],
            "description": "As stated in the source. Never converted at rest."
          },
          "unit_price": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Every field the supplier did not state, with the reason. Requirement 3.2: recorded as null with a stated reason, never inferred."
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
