{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeorgeLukaanya/bse4104-procurement-agent/blob/main/docs/architecture/schemas/supplier-record.json",
  "title": "Supplier record",
  "description": "One entry of knowledge/data/suppliers.json. Membership of that file is the Approved Vendor List; absence yields AVL_ABSENT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supplier_id",
    "registered_name",
    "categories",
    "avl_status",
    "approval_date",
    "status_effective_date"
  ],
  "properties": {
    "supplier_id": {
      "type": "string",
      "pattern": "^SUP-[0-9]{3}$"
    },
    "registered_name": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cement and masonry",
          "hand tools and safety equipment",
          "electrical and plumbing"
        ]
      },
      "description": "Approved categories. A quotation outside them is OUT_OF_CATEGORY under POL-002-C03."
    },
    "avl_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "BLACKLISTED"
      ]
    },
    "approval_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status_effective_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "When the current status took effect. Carried separately because POL-002-C02 makes a suspension override an older approval."
    },
    "terms_document": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path to a supplier-terms document, or null. A terms document is descriptive and confers no eligibility."
    },
    "notes": {
      "type": "string"
    }
  }
}
